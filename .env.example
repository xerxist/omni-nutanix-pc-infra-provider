# Copy to an ignored .env for docker-compose.yml. Values here are paths and
# settings only; never put credential values in .env.

# Release digest from https://github.com/xerxist/omni-nutanix-pc-infra-provider/releases
PROVIDER_IMAGE=ghcr.io/xerxist/omni-nutanix-pc-infra-provider@sha256:<digest>

# Host directories, mounted read-only. Secrets must be readable by UID/GID 65532;
# the CA directory holds public PEM bundles only and may be empty.
PROVIDER_SECRETS_DIR=
PROVIDER_CERTS_DIR=

OMNI_ENDPOINT=
NUTANIX_ENDPOINT=
PROVIDER_ID=nutanix-pc
PROVIDER_NAME=Nutanix Prism Central
PROVIDER_DESCRIPTION=Nutanix infrastructure provider
PROVIDER_REGISTRATION_ONLY=false

# Container paths under /run/secrets (PROVIDER_SECRETS_DIR on the host).
OMNI_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/omni-service-account-key
NUTANIX_API_KEY_FILE=/run/secrets/nutanix-api-key
# For Basic authentication, clear NUTANIX_API_KEY_FILE and set both:
NUTANIX_USERNAME_FILE=
NUTANIX_PASSWORD_FILE=

# Optional public CA bundles, e.g. /etc/provider/certs/prism-ca.pem
NUTANIX_CA_FILE=
TALOS_GUEST_CA_FILE=
IMAGE_FACTORY_CA_FILE=

IMAGE_IMPORT_ENABLED=false
IMAGE_FACTORY_ENDPOINT=https://factory.talos.dev
OMNI_INSECURE_SKIP_VERIFY=false
NUTANIX_INSECURE_SKIP_VERIFY=false
NUTANIX_VMM_VERSION=v4.0
NUTANIX_NETWORKING_VERSION=v4.0
NUTANIX_CLUSTER_VERSION=v4.0
NUTANIX_PRISM_VERSION=v4.0
PROVIDER_STOP_GRACE_PERIOD=150s
