# Copy to an ignored deployment.env. Names/image are deployment-specific inputs.
PROVIDER_DEPLOYMENT_NAME=
PROVIDER_NAMESPACE=
# Release digest, e.g. ghcr.io/xerxist/omni-nutanix-pc-infra-provider@sha256:<digest>
PROVIDER_IMAGE=
PROVIDER_CONFIGMAP_NAME=
PROVIDER_CREDENTIAL_SECRET_NAME=
PROVIDER_CA_CONFIGMAP_NAME=
PROVIDER_TERMINATION_GRACE_SECONDS=150
PROVIDER_CPU_REQUEST=100m
PROVIDER_MEMORY_REQUEST=128Mi
PROVIDER_CPU_LIMIT=1
PROVIDER_MEMORY_LIMIT=512Mi
PROVIDER_TMP_SIZE_LIMIT=64Mi
